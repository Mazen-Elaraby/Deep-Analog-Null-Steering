\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Suppression against direction error over $4{,}000$ single-jammer scenes (PH4). The relationship is strikingly flat: the median $\mathrm  {JSR}$ falls only from $34.24\,\mathrm  {dB}$ for scenes accurate to within $1^\circ $ to $28.21\,\mathrm  {dB}$ for scenes accurate to within $5^\circ $. A null cast by a $0.224\lambda $ aperture is broad, so the suppression tolerates a direction error of several degrees almost without penalty.}}{15}{figure.caption.15}\protected@file@percent }
\newlabel{fig:jsrerr}{{11}{15}{Suppression against direction error over $\jsrN $ single-jammer scenes (PH4). The relationship is strikingly flat: the median $\JSR $ falls only from $\jsrErrOne \dB $ for scenes accurate to within $1\degs $ to $\jsrErrFive \dB $ for scenes accurate to within $5\degs $. A null cast by a $\apertureLambda \lambda $ aperture is broad, so the suppression tolerates a direction error of several degrees almost without penalty}{figure.caption.15}{}}
