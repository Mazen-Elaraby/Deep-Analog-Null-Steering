\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Cumulative distribution of the single-jammer arc error over $10{,}000$ scenes. The distribution is tail-dominated: the median is $3.717^\circ $ but the $\mathrm  {RMSE}$ is $7.072^\circ $, so the two summaries answer different questions and both are reported.}}{10}{figure.caption.4}\protected@file@percent }
\newlabel{fig:cdf}{{2}{10}{Cumulative distribution of the single-jammer arc error over $\phOneN $ scenes. The distribution is tail-dominated: the median is $\netArcPfifty \degs $ but the $\RMSE $ is $\netArcRmse \degs $, so the two summaries answer different questions and both are reported}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Random-DoA sweep over $10{,}000$ scenes (PH1). Accuracy is flat in jammer-to-noise ratio across the whole generator range, $7.240^\circ $ RMSE in the lowest decade against $7.114^\circ $ in the highest, because a notch codebook reports a ratio of powers and the ratio is insensitive to the common scale. The ratio $\mathrm  {RMSE}/\mathrm  {CRB}$, by contrast, is strongly geometry-dependent: $1.93$ on the well-conditioned half of the scenes and $0.70$ on the ill-conditioned half. The aggregate $0.75$ is an average of two populations that behave oppositely and is not an efficiency.}}{10}{figure.caption.5}\protected@file@percent }
\newlabel{fig:eff}{{3}{10}{Random-DoA sweep over $\phOneN $ scenes (PH1). Accuracy is flat in jammer-to-noise ratio across the whole generator range, $\netRmseJnrLo \degs $ RMSE in the lowest decade against $\netRmseJnrHi \degs $ in the highest, because a notch codebook reports a ratio of powers and the ratio is insensitive to the common scale. The ratio $\RMSE /\CRB $, by contrast, is strongly geometry-dependent: $\effWell $ on the well-conditioned half of the scenes and $\effIll $ on the ill-conditioned half. The aggregate $\effAgg $ is an average of two populations that behave oppositely and is not an efficiency}{figure.caption.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {III}{\ignorespaces Fixed-DoA bias/variance decomposition, split at this experiment's own median bound ($1.985^\circ $). All quantities in degrees except the last two columns. Between the halves the bias grows $4.5\times $ while the scatter moves by $7\%$: the degradation is almost entirely systematic.}}{11}{table.caption.6}\protected@file@percent }
\newlabel{tab:biasvar}{{III}{11}{Fixed-DoA bias/variance decomposition, split at this experiment's own median bound ($\fdSplit \degs $). All quantities in degrees except the last two columns. Between the halves the bias grows $\fdBiasGrowth \times $ while the scatter moves by $\fdScatGrowth \%$: the degradation is almost entirely systematic}{table.caption.6}{}}
