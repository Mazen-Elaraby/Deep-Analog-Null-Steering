\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Multi-jammer degradation (PH3J). Error distributions for $J \in \{1, 2, 3\}$ on common axes, together with the joint-nulling outcome at $J = 3$. With $J = 3$ nulls demanded of an $4$-element array only a single spatial degree of freedom is left over, so even exact directions would purchase limited quiescent gain; the $J = 3$ figures should be read as feasibility numbers rather than as an operating point.}}{13}{figure.caption.11}\protected@file@percent }
\newlabel{fig:multij}{{7}{13}{Multi-jammer degradation (PH3J). Error distributions for $J \in \{1, 2, 3\}$ on common axes, together with the joint-nulling outcome at $J = 3$. With $J = 3$ nulls demanded of an $\numElem $-element array only a single spatial degree of freedom is left over, so even exact directions would purchase limited quiescent gain; the $J = 3$ figures should be read as feasibility numbers rather than as an operating point}{figure.caption.11}{}}
